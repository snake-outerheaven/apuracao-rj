{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apuração RJ",
  "version": "0.1.0",
  "identifier": "br.apuracao.rj",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Apuração RJ — 2º turno 2026 (não oficial)", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "category": "News",
    "shortDescription": "Apuração do 2º turno 2026 no RJ (não oficial)",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../config/": "config/",
      "../fixtures/mock/": "fixtures/mock/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "SUBSTITUIR_PELA_CHAVE_PUBLICA_DO_UPDATER",
      "endpoints": ["https://github.com/apuracao-rj/apuracao-rj/releases/latest/download/latest.json"]
    }
  }
}
